# VPS public IP or DNS name, without a scheme/port. Used in generated client files.
PUBLIC_HOST=vps.example.com

# REALITY camouflage target: reachable TLS 1.3 / HTTP2 website, not the VPS itself.
REALITY_SERVER_NAME=www.cloudflare.com
# Empty means REALITY_SERVER_NAME:443. Set explicitly for a different target address.
REALITY_TARGET=

# Public and container ports use the same values in compose.yaml.
XRAY_PORT=8443
RATHOLE_PORT=2333
TZ=Asia/Shanghai

# Replace latest with a release tag or digest to pin the image.
XLINK_IMAGE=ghcr.io/nekoimi/xlink-runtime:latest
